# ================== HÀM PHỤ LANE ==================
def compute_path_center(mask, top_ratio=PATH_TOP_RATIO, bottom_ratio=PATH_BOTTOM_RATIO,
                        step=PATH_ROW_STEP, min_total_pixels=200):
    h, w = mask.shape
    y0 = int(h * top_ratio)
    y1 = int(h * bottom_ratio)
    if y1 <= y0:
        y1 = y0 + 1

    rows = []
    total_pixels = 0

    for y in range(y0, y1, step):
        row = mask[y, :]
        xs = np.where(row > 0)[0]
        if xs.size < 5:
            continue

        left = int(xs[0])
        right = int(xs[-1])
        cx_row = 0.5 * (left + right)

        rows.append((y, cx_row))
        total_pixels += xs.size

    if len(rows) == 0 or total_pixels < min_total_pixels:
        return None, None, None

    rows.sort(key=lambda r: r[0])
    far_cx  = rows[0][1]
    near_cx = rows[-1][1]

    path_cx = 0.3 * far_cx + 0.7 * near_cx
    return float(path_cx), float(near_cx), float(far_cx)

def get_left_right_lane_strength(mask, cx):
    h, w = mask.shape
    cx = int(np.clip(cx, 0, w - 1))
    left_area = int(mask[:, :cx].sum())
    right_area = int(mask[:, cx:].sum())
    return left_area, right_area

def get_lane_from_road_boxes(road_boxes, img_width):
    if not road_boxes:
        return None
    best_box = max(road_boxes, key=lambda b: b[3])
    x1, y1, x2, y2, conf, cls_id = best_box
    mid = float((x1 + x2) / 2.0)
    return mid

def keep_largest_lane(mask, min_area=300):
    if mask is None:
        return mask

    m = (mask > 0).astype(np.uint8)
    if m.max() == 0:
        return m

    num_labels, labels, stats, _ = cv2.connectedComponentsWithStats(m, connectivity=8)
    if num_labels <= 1:
        return m

    areas = stats[1:, cv2.CC_STAT_AREA]
    max_idx_relative = int(np.argmax(areas))
    max_area = areas[max_idx_relative]

    if max_area < min_area:
        return np.zeros_like(mask, dtype=np.uint8)

    max_idx = 1 + max_idx_relative
    largest_mask = np.zeros_like(mask, dtype=np.uint8)
    largest_mask[labels == max_idx] = 1
    return largest_mask

def smooth_lane_edges(mask, erode_iter=1, dilate_iter=1, kernel_size=3):
    if mask is None:
        return mask
    if mask.max() == 0:
        return mask

    m = (mask > 0).astype(np.uint8) * 255
    kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (kernel_size, kernel_size))

    m = cv2.morphologyEx(m, cv2.MORPH_CLOSE, kernel, iterations=1)

    if erode_iter > 0:
        m = cv2.erode(m, kernel, iterations=erode_iter)
    if dilate_iter > 0:
        m = cv2.dilate(m, kernel, iterations=dilate_iter)

    out = (m > 0).astype(np.uint8)
    return out

def apply_trapezoid_roi(mask,
                        top_y_ratio=TRAP_TOP_Y_RATIO,
                        bottom_y_ratio=TRAP_BOTTOM_Y_RATIO,
                        top_width_ratio=TRAP_TOP_WIDTH_RATIO,
                        bottom_width_ratio=TRAP_BOTTOM_WIDTH_RATIO):
    if mask is None:
        return mask
    if mask.max() == 0:
        return mask

    h, w = mask.shape
    y_top = int(h * top_y_ratio)
    y_bottom = int(h * bottom_y_ratio)
    if y_bottom <= y_top:
        y_bottom = y_top + 1

    cx = w // 2
    half_top = int((w * top_width_ratio) / 2.0)
    half_bottom = int((w * bottom_width_ratio) / 2.0)

    x_left_top     = int(np.clip(cx - half_top, 0, w-1))
    x_right_top    = int(np.clip(cx + half_top, 0, w-1))
    x_left_bottom  = int(np.clip(cx - half_bottom, 0, w-1))
    x_right_bottom = int(np.clip(cx + half_bottom, 0, w-1))

    pts = np.array([
        [x_left_bottom,  y_bottom],
        [x_right_bottom, y_bottom],
        [x_right_top,    y_top],
        [x_left_top,     y_top],
    ], dtype=np.int32)

    roi = np.zeros_like(mask, dtype=np.uint8)
    cv2.fillPoly(roi, [pts], 1)

    masked = mask * roi
    return masked

# ================== TURN FORCE HELPERS ==================
def extract_row_segments(mask, y, min_run=8, gap_thresh=4):
    h, w = mask.shape
    y = int(np.clip(y, 0, h - 1))
    row = mask[y, :]
    xs = np.where(row > 0)[0]
    if xs.size == 0:
        return []

    split_idx = np.where(np.diff(xs) > gap_thresh)[0]
    groups = []
    start = 0
    for s in split_idx:
        groups.append(xs[start:s+1])
        start = s + 1
    groups.append(xs[start:])

    segs = []
    for g in groups:
        if g.size < min_run:
            continue
        left = int(g[0])
        right = int(g[-1])
        width = right - left + 1
        cx = 0.5 * (left + right)
        segs.append((left, right, cx, width))

    segs.sort(key=lambda t: t[2])
    return segs

def pick_branch_cx_by_sign(lane_mask_raw, sign_label, cx_img,
                           row_ratio=0.55, min_segments=2,
                           min_run=8, gap_thresh=4):
    if sign_label not in ("turn_left", "turn_right", "go_straight"):
        return None

    h, w = lane_mask_raw.shape
    y = int(h * row_ratio)

    segs = extract_row_segments(lane_mask_raw, y, min_run=min_run, gap_thresh=gap_thresh)
    if len(segs) < min_segments:
        return None

    if sign_label == "turn_left":
        return float(segs[0][2])

    if sign_label == "turn_right":
        return float(segs[-1][2])

    best = min(segs, key=lambda s: abs(s[2] - cx_img))
    return float(best[2])

# ================== PID & TỐC ĐỘ ==================
class PIDController:
    def __init__(self, kp, ki, kd, max_output=25):
        self.kp = kp
        self.ki = ki
        self.kd = kd
        self.max_output = max_output
        self.integral = 0.0
        self.last_error = 0.0
        self.last_time = time.time()

    def reset(self):
        self.integral = 0.0
        self.last_error = 0.0
        self.last_time = time.time()

    def compute(self, error):
        now = time.time()
        dt = now - self.last_time
        self.last_time = now
        if dt < 1e-3:
            dt = 1e-3

        e = float(error)

        p = self.kp * e
        self.integral += e * dt
        self.integral = max(min(self.integral, 8.0), -8.0)
        i = self.ki * self.integral

        de = (e - self.last_error) / dt
        self.last_error = e
        d = self.kd * de

        out = p + i + d
        out = max(min(out, self.max_output), -self.max_output)
        return float(out)

def adaptive_speed_control(error_px, base_speed=BASE_SPEED, min_speed=MIN_SPEED):
    e = abs(float(error_px))
    x = min(e / ERROR_NORM_PIX, 1.5)
    factor = 1.0 - x ** 1.6
    speed = base_speed * max(factor, 0.0)
    if speed < min_speed:
        speed = min_speed
    return int(speed)

# ================== TRẠNG THÁI BIỂN BÁO ==================
class SignState:
    def __init__(self, hold_frames=SIGN_HOLD_FRAMES,
                 history_len=15, min_stable=4,
                 stable_frac_accept=0.7, stable_frac_switch=0.85):
        self.label = None
        self.frames_left = 0
        self.hold_frames = hold_frames

        self.history = deque(maxlen=history_len)
        self.min_stable = min_stable
        self.stable_frac_accept = stable_frac_accept
        self.stable_frac_switch = stable_frac_switch

    def step(self):
        if self.frames_left > 0:
            self.frames_left -= 1
            if self.frames_left == 0:
                self.label = None

    def update_from_dets(self, det_labels, det_confs):
        VALID_SIGNS = (
            'go_straight',
            'turn_left',
            'turn_right',
            'no_left',
            'no_right',
            'no_straight',
            'stop_sign',
        )

        best_label = None
        best_conf = 0.0
        for lab, cf in zip(det_labels, det_confs):
            if lab not in VALID_SIGNS:
                continue
            if cf > best_conf:
                best_conf = cf
                best_label = lab

        self.history.append(best_label)

        counts = {}
        total_non_none = 0
        for lab in self.history:
            if lab is None:
                continue
            counts[lab] = counts.get(lab, 0) + 1
            total_non_none += 1

        if total_non_none < self.min_stable or not counts:
            return

        stable_label = max(counts, key=counts.get)
        stable_count = counts[stable_label]
        stable_frac = stable_count / float(total_non_none)

        if stable_frac < self.stable_frac_accept:
            return

        if self.label is None or stable_label == self.label:
            self.label = stable_label
            self.frames_left = self.hold_frames
        else:
            if stable_frac >= self.stable_frac_switch:
                self.label = stable_label
                self.frames_left = self.hold_frames

    def current(self):
        return self.label

def apply_sign_logic(error_px, lane_mask, sign_label, cx):
    # Bias mềm. Junction force sẽ override path_cx trong main.
    if sign_label is None:
        return float(error_px)

    e = float(error_px)

    if sign_label == 'go_straight':
        e *= 0.5
        return e

    if sign_label == 'turn_left':
        e -= TURN_BIAS_PIX
        return e

    if sign_label == 'turn_right':
        e += TURN_BIAS_PIX
        return e

    if sign_label == 'no_left':
        if e < -NO_TURN_TOL:
            e = max(e, 0.0)
        return e

    if sign_label == 'no_right':
        if e > NO_TURN_TOL:
            e = min(e, 0.0)
        return e

    if sign_label == 'no_straight':
        left_area, right_area = get_left_right_lane_strength(lane_mask, cx)
        if left_area > right_area * 1.1:
            e -= TURN_BIAS_PIX
        elif right_area > left_area * 1.1:
            e += TURN_BIAS_PIX
        else:
            e -= TURN_BIAS_PIX * 0.7
        return e

    return e


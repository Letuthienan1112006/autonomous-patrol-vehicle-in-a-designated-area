    if ret != 0:
        print(f'❌ Load RKNN thất bại, code = {ret}')
        return

    print('Đang init_runtime...')
    ret = rknn.init_runtime(target='rk3588')
    if ret != 0:
        print(f'❌ init_runtime thất bại, code = {ret}')
        return
    print('✅ RKNN đã sẵn sàng.')

    print('Khởi tạo camera...')
    cap = cv2.VideoCapture(0)
    if not cap.isOpened():
        print('❌ Không mở được camera.')
        rknn.release()
        return

    # --------- KHỞI TẠO IMU + BRIDGE PROCESSOR ---------
    imu = BNO055Compass()
    bridge_proc = BridgeProcessor()

    bridge_armed = False           # ARM khi thấy brige1
    bridge_seen_count = 0
    last_bridge_frame = -9999

    bridge_state_name = "NORMAL"
    prev_bridge_state_name = "NORMAL"
    bridge_speed_coeff = 1.0
    pitch_raw = 0.0
    pitch_filtered = 0.0

    # ===== BRIDGE v2 flags =====
    bridge2_seen = False   # MID-bridge sign seen (biển giữa cầu)
    top_slow_active = False

    # ===== DOWN stop control =====
    down_frames = 0
    down_stop_frames_left = 0
    down_stop1_done = False
    down_stop2_done = False

    writer = None
    video_path = None
    if SAVE_VIDEO:
        os.makedirs(VIDEO_DIR, exist_ok=True)
        ts = time.strftime('%Y%m%d_%H%M%S')
        video_path = os.path.join(VIDEO_DIR, f'drive_{ts}.avi')
        fourcc = cv2.VideoWriter_fourcc(*'XVID')
        writer = cv2.VideoWriter(video_path, fourcc, VIDEO_FPS,
                                 (INPUT_W * 3, INPUT_H))
        if writer.isOpened():
            print('Đang ghi video vào:', video_path)
        else:
            print('Không mở được VideoWriter, sẽ không ghi video.')
            writer = None

    pid = PIDController(KP, KI, KD, MAX_ANGLE)
    sign_state = SignState()
    colorlist = gen_color(len(CLASSES))

    fps_hist = deque(maxlen=50)
    frame_count = 0

    last_mid = INPUT_W // 2
    lost_frames = 0

    prev_boxes = None
    prev_masks = None
    prev_shape_hw = None
    MAX_DET_HOLD = 5
    det_hold_count = 0

    mode = MODE_FORWARD
    angle_history = deque(maxlen=20)
    last_good_angle_cmd = 0.0
    base_turn_angle = 0.0

    speed_cmd = 0
    angle_cmd = 0.0

    try:
        while True:
            t0 = time.perf_counter()

            ret, frame = cap.read()
            if not ret:
                print('Mất frame camera.')
                break

            # --- ĐỌC IMU ---
            prev_bridge_state_name = bridge_state_name
            euler = imu.get_euler_angles()
            if euler:
                _, _, pitch_raw = euler
                imu_ctrl = bridge_proc.update(pitch_raw)

                bridge_state_name  = imu_ctrl.get("state", "NORMAL")
                pitch_filtered     = imu_ctrl.get("pitch_filtered", 0.0)
                bridge_speed_coeff = imu_ctrl.get("speed_coeff", 1.0)
            else:
                bridge_state_name  = "NORMAL"
                pitch_filtered     = 0.0
                bridge_speed_coeff = 1.0

            # ===== DOWN frame counter + reset =====
            if bridge_state_name != "DOWN":
                down_frames = 0
                down_stop_frames_left = 0
                down_stop1_done = False
                down_stop2_done = False
            else:
                down_frames += 1

            # ===== Hết cầu =====
            if prev_bridge_state_name == "DOWN" and bridge_state_name == "NORMAL":
                if bridge_armed:
                    print("[BRIDGE-IMU] Kết thúc cầu -> unarm bridge")

                bridge_armed = False
                bridge_seen_count = 0

                bridge2_seen = False
                top_slow_active = False

                down_frames = 0
                down_stop_frames_left = 0
                down_stop1_done = False
                down_stop2_done = False

            # --- PREPROCESS ---
            img0 = frame.copy()
            img4, img3 = preprocess(img0, INPUT_H, INPUT_W)
            img_in = img3.astype(np.uint8)

            # --- INFERENCE ---
            outputs = None
            try:
                outputs = rknn.inference(inputs=[img_in], data_format='nhwc')
            except KeyboardInterrupt:
                print("[ERROR] KeyboardInterrupt trong inference -> gửi (0, 0)")
                control(0, 0)
                break
            except Exception as e:
                print(f"[ERROR] {e} -> gửi (0, 0)")
                control(0, 0)
                continue

            if outputs is None:
                print("[ERROR] inference trả về None -> gửi (0, 0)")
                control(0, 0)
                continue

            results_list = postprocess(
                outputs,
                img4,
                img3,
                CONF_THRES,
                IOU_THRES,
                classes=len(CLASSES),
            )
            boxes, masks, shape_hw = results_list[0]

            has_det_now = isinstance(boxes, np.ndarray) and boxes.size > 0 and \
                          isinstance(masks, np.ndarray) and masks.size > 0

            if has_det_now:
                prev_boxes = boxes
                prev_masks = masks
                prev_shape_hw = shape_hw
                det_hold_count = 0
            else:
                if prev_boxes is not None and det_hold_count < MAX_DET_HOLD:
                    print("[DET-HOLD] dùng lại boxes/masks từ frame trước")
                    boxes = prev_boxes
                    masks = prev_masks
                    shape_hw = prev_shape_hw
                    det_hold_count += 1
                else:
                    prev_boxes = None
                    prev_masks = None
                    prev_shape_hw = None
                    det_hold_count = 0

            if isinstance(shape_hw, (tuple, list)) and len(shape_hw) == 2:
                H, W = shape_hw
            else:
                H, W = INPUT_H, INPUT_W

            lane_mask = np.zeros((H, W), dtype=np.uint8)
            sign_labels = []
            sign_confs = []
            road_boxes = []

            bridge_detected = False

            # --- PARSE DETS ---
            if isinstance(boxes, np.ndarray) and boxes.size > 0 and \
               isinstance(masks, np.ndarray) and masks.size > 0:
                for box, mask in zip(boxes, masks):
                    cls_id = int(box[5])
                    conf = float(box[4])
                    if cls_id < 0 or cls_id >= len(CLASSES):
                        continue
                    name = CLASSES[cls_id]

                    x1, y1, x2, y2 = box[:4]
                    w_box = max(x2 - x1, 0.0)
                    h_box = max(y2 - y1, 0.0)
                    area = w_box * h_box
                    cx_box = (x1 + x2) / 2.0
                    cy_box = (y1 + y2) / 2.0

                    if name == ROAD_CLASS_NAME:
                        if conf < CONF_THRES_ROAD:
                            continue
                        lane_mask |= (mask > 0).astype(np.uint8)
                        road_boxes.append(box)

                    elif name == BRIDGE_LABEL_NAME:
                        if conf < CONF_SIGN:
                            continue
                        if area < MIN_SIGN_AREA:
                            continue
                        bridge_detected = True

                    else:
                        if conf < CONF_SIGN:
                            continue
                        if area < MIN_SIGN_AREA:
                            continue
                        cx_norm = cx_box / float(W)
                        cy_norm = cy_box / float(H)
                        if cx_norm < SIGN_ROI_X_MIN or cx_norm > SIGN_ROI_X_MAX:
                            continue
                        if cy_norm < SIGN_ROI_Y_MIN or cy_norm > SIGN_ROI_Y_MAX:
                            continue
                        sign_labels.append(name)
                        sign_confs.append(conf)

            # --- SIGN STATE ---
            sign_state.step()
            sign_state.update_from_dets(sign_labels, sign_confs)
            cur_sign = sign_state.current()

            # --- BRIDGE SIGN COUNT ---
            if bridge_detected:
                print(f"[BRIDGE] detected at frame={frame_count}, armed={bridge_armed}")
                if frame_count - last_bridge_frame > 30:
                    last_bridge_frame = frame_count

                    if not bridge_armed:
                        bridge_armed = True
                        bridge_seen_count = 1
                        print("[BRIDGE] brige1 -> ARM")
                    else:
                        bridge_seen_count += 1
                        print(f"[BRIDGE] brige again, count={bridge_seen_count}")

                    if bridge_seen_count >= 2:
                        bridge2_seen = True
                        print("[BRIDGE] MID sign detected (brige2) -> allow TOP slow + prefer DOWN policy")

            # --- TOP slow activation ---
            if bridge_armed and bridge2_seen and bridge_state_name == "TOP":
                if not top_slow_active:
                    print("[BRIDGE] IMU=TOP & MID sign -> TOP slow ACTIVE")
                top_slow_active = True

            print(f"[BRIDGE-STATE] state={bridge_state_name}, armed={bridge_armed}, "
                  f"seen={bridge_seen_count}, mid={int(bridge2_seen)}, topSlow={int(top_slow_active)}, "
                  f"pitch_raw={pitch_raw:.1f}° filt={pitch_filtered:.1f}° "
                  f"coeff(IMU)={bridge_speed_coeff:.2f} down_frames={down_frames} "
                  f"stop_left={down_stop_frames_left}")

            # ================== LỌC LANE (2 BẢN) ==================
            # RAW: giữ nhiều nhánh để ép rẽ ở junction
            lane_mask_raw = lane_mask.copy()
            lane_mask_raw = smooth_lane_edges(lane_mask_raw, erode_iter=1, dilate_iter=1, kernel_size=3)
            lane_mask_raw = apply_trapezoid_roi(lane_mask_raw)

            # MAIN: giữ nhánh lớn nhất để bám lane ổn định
            lane_mask = keep_largest_lane(lane_mask, min_area=300)
            lane_mask = smooth_lane_edges(lane_mask, erode_iter=1, dilate_iter=1, kernel_size=3)
            lane_mask = apply_trapezoid_roi(lane_mask)

            lane_sum = int(lane_mask.sum())
            h_mask, w_mask = lane_mask.shape
            cx = w_mask // 2

            path_cx = near_cx = far_cx = None
            if lane_sum > 0:
                path_cx, near_cx, far_cx = compute_path_center(lane_mask)

            if path_cx is None and road_boxes:
                mid_box = get_lane_from_road_boxes(road_boxes, w_mask)
                if mid_box is not None:
                    path_cx = mid_box
                    near_cx = mid_box
                    far_cx  = mid_box

            # ===== TURN FORCE ở junction =====
            if TURN_FORCE_ENABLE and lane_mask_raw is not None:
                if int(lane_mask_raw.sum()) > 0:
                    forced_cx = pick_branch_cx_by_sign(
                        lane_mask_raw,
                        cur_sign,
                        cx,
                        row_ratio=TURN_FORCE_ROW_RATIO,
                        min_segments=TURN_FORCE_MIN_SEGMENTS,
                        min_run=TURN_FORCE_MIN_RUN,
                        gap_thresh=TURN_FORCE_GAP
                    )
                    if forced_cx is not None:
                        path_cx = forced_cx
                        near_cx = forced_cx
                        far_cx  = forced_cx
                        print(f"[TURN-FORCE] sign={cur_sign} -> forced path_cx={forced_cx:.1f}")

            curvature = 0.0
            if far_cx is not None and near_cx is not None:
                curvature = abs(far_cx - near_cx)

            lane_found = (path_cx is not None)

            # ================= LOGIC LÁI =================
            if lane_found:
                if mode != MODE_FORWARD:
                    pid.reset()
                    mode = MODE_FORWARD
                lost_frames = 0

                error_px = path_cx - cx
                base_speed_eff = BASE_SPEED

                if curvature > CURV_THRESH_2:
                    if not (bridge_armed and bridge_state_name == "DOWN"):
                        error_px *= CURV_ERROR_BOOST_2
                    base_speed_eff = BASE_SPEED - 8
                elif curvature > CURV_THRESH_1:
                    if not (bridge_armed and bridge_state_name == "DOWN"):
                     error_px *= CURV_ERROR_BOOST_1
                    base_speed_eff = BASE_SPEED - 4

                last_mid = int(path_cx)

                error_cmd = apply_sign_logic(error_px, lane_mask, cur_sign, cx)

                angle_cmd = -pid.compute(error_cmd)
                angle_cmd = max(min(angle_cmd, MAX_ANGLE), -MAX_ANGLE)
                # ===== GIẢM GÓC RIÊNG KHI XUỐNG CẦU =====
                if bridge_armed and bridge_state_name == "DOWN":
                    angle_cmd *= BRIDGE_DOWN_ANGLE_COEFF
                    angle_cmd = max(min(angle_cmd, BRIDGE_DOWN_MAX_ANGLE), -BRIDGE_DOWN_MAX_ANGLE)

                last_good_angle_cmd = angle_cmd
                angle_history.append(angle_cmd)

                if cur_sign == 'stop_sign':
                    speed_cmd = 0
                else:
                    speed_cmd = adaptive_speed_control(error_cmd, base_speed=base_speed_eff)

                    # ================== BRIDGE POLICY v2 refined ==================
                    top_policy_ok  = bridge_armed and bridge2_seen
                    down_policy_ok = bridge_armed and (bridge2_seen or down_frames >= BRIDGE_DOWN_FALLBACK_FR)

                    if bridge_armed:
                        if bridge_state_name == "TOP":
                            if top_policy_ok and top_slow_active:
                                speed_cmd = int(speed_cmd * BRIDGE_TOP_SLOW_COEFF)
                            else:
                                speed_cmd = int(speed_cmd * bridge_speed_coeff)

                        elif bridge_state_name == "DOWN":
                            if down_policy_ok:
                                # Stop #1 mid-slope
                                if (not down_stop1_done) and (down_frames >= BRIDGE_DOWN_STOP1_AT_FR):
                                    down_stop_frames_left = BRIDGE_DOWN_STOP_HOLD_FR
                                    down_stop1_done = True
                                    print("[BRIDGE-DOWN] Stop #1 (mid-slope)")

                                # Stop #2 near-end
                                if (not down_stop2_done) and \
                                   (down_frames >= BRIDGE_DOWN_MIN_FR_BEFORE_END) and \
                                   (abs(pitch_filtered) <= BRIDGE_DOWN_END_PITCH_DEG):
                                    down_stop_frames_left = BRIDGE_DOWN_STOP_HOLD_FR
                                    down_stop2_done = True
                                    print("[BRIDGE-DOWN] Stop #2 (near-end)")

                                if down_stop_frames_left > 0:
                                    down_stop_frames_left -= 1
                                    speed_cmd = 0
                                else:
                                    speed_cmd = int(speed_cmd * BRIDGE_DOWN_SLOW_COEFF)
                            else:
                                speed_cmd = int(speed_cmd * bridge_speed_coeff)

                        elif bridge_state_name == "UP":
                            speed_cmd = int(speed_cmd * bridge_speed_coeff)
                        else:
                            speed_cmd = int(speed_cmd * bridge_speed_coeff)
                    else:
                        speed_cmd = int(speed_cmd * bridge_speed_coeff)

                    if speed_cmd < 0:
                        speed_cmd = 0

                print(
                    f"[CMD-FWD] sign={cur_sign}, error_px={error_px:.1f}, error_cmd={error_cmd:.1f}, "
                    f"curv={curvature:.1f}, speed={speed_cmd}, angle={angle_cmd:.1f}, "
                    f"bridge_state={bridge_state_name}, mid={int(bridge2_seen)}, down_frames={down_frames}"
                )

                control(speed_cmd, angle_cmd)

            else:
                lost_frames += 1
                print(f"[LOST] lane not found, lost_frames={lost_frames}, mode={mode}")

                if mode == MODE_FORWARD:
                    if lost_frames == 1:
                        control(0, 0)
                    elif lost_frames >= RECOV_LOST_FRAMES_TRIGGER:
                        if len(angle_history) > 0:
                            base_turn_angle = max(angle_history, key=lambda a: abs(a))
                        else:
                            base_turn_angle = last_good_angle_cmd

                        base_turn_angle = max(min(base_turn_angle, MAX_ANGLE), -MAX_ANGLE)
                        mode = MODE_RECOV_BACK
                        recover_angle = -base_turn_angle
                        print(f"[RECOV-START-BACK] base_turn_angle={base_turn_angle:.1f}")
                        control(RECOV_REVERSE_SPEED, recover_angle)
                else:
                    recover_angle = -base_turn_angle
                    control(RECOV_REVERSE_SPEED, recover_angle)

            # === FPS & RECORD VIDEO ===
            t1 = time.perf_counter()
            fps = 1.0 / max(t1 - t0, 1e-6)
            fps_hist.append(fps)
            frame_count += 1
            avg_fps = sum(fps_hist) / len(fps_hist)

            if isinstance(masks, np.ndarray) and isinstance(boxes, np.ndarray) and boxes.size > 0:
                _, vis_img = vis_result(
                    img3, (boxes, masks, (H, W)),
                    colorlist, CLASSES, onScreen=True
                )
            else:
                vis_small = cv2.resize(frame, (INPUT_W, INPUT_H))
                vis_img = np.concatenate([vis_small, vis_small, vis_small], axis=1)

            cv2.putText(
                vis_img,
                f'FPS:{avg_fps:.1f} sign:{cur_sign} lost:{lost_frames} '
                f'mode:{mode} speed:{speed_cmd} angle:{angle_cmd:.1f}',
                (10, 25),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.6,
                (0, 255, 0),
                2,
                cv2.LINE_AA
            )

            cv2.putText(
                vis_img,
                f'pitch:{pitch_filtered:.1f} state:{bridge_state_name} '
                f'mid:{int(bridge2_seen)} topSlow:{int(top_slow_active)} '
                f'downFr:{down_frames} stopLeft:{down_stop_frames_left}',
                (10, 50),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.6,
                (0, 255, 0),
                2,
                cv2.LINE_AA
            )

            if writer is not None:
                writer.write(vis_img)

    except KeyboardInterrupt:
        print('Dừng bởi người dùng.')
    finally:
        print("[FINAL] Gửi (0,0) và đóng tài nguyên.")
        control(0, 0)
        cap.release()
        rknn.release()
        if writer is not None:
            writer.release()
            print('Đã lưu video tại:', video_path)
        close_serial()
        cv2.destroyAllWindows()


if __name__ == '__main__':
    main()

